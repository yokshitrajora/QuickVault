generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id      String @id @default(cuid())
  auth0Id String @unique
  email   String @unique
  name    String
  avatar  String?
  items   Item[]
  tags    Tag[]
  createdAt DateTime @default(now())
}

model Item {
  id          String   @id @default(cuid())
  type        String   // BOOKMARK | SNIPPET | NOTE
  title       String
  url         String?
  description String?
  content     String?
  language    String?
  ogImage     String?
  favicon     String?
  isFavorite  Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        ItemTag[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  ItemTag[]

  @@unique([name, userId])
}

model ItemTag {
  itemId String
  tagId  String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}
