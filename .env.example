# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quickvault?schema=public"
# Or for SQLite:
# DATABASE_URL="file:./dev.db"

# Auth0 Authentication Configuration
AUTH0_SECRET="your_32_character_long_secret_key_generated_with_openssl"
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_ISSUER_BASE_URL="https://your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your_auth0_client_id"
AUTH0_CLIENT_SECRET="your_auth0_client_secret"

# Demo Mode (Allows instantaneous testing without Auth0 keys)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
