{
  "info": {
    "_postman_id": "quickvault-api-collection",
    "name": "QuickVault API",
    "description": "API collection for QuickVault — Smart Bookmark & Notes Hub. Includes Authentication, Bookmarks, Snippets, Notes, Tags, and Metadata Scraper.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1-Click Demo Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.environment.set('token', res.token);",
                  "    console.log('Saved token to collection & environment:', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/demo",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "demo"]
            },
            "description": "Logs in instantly as Demo User and captures the Bearer token for subsequent requests."
          }
        },
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.environment.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivera\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.environment.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Get Items (Filtered by Type / Query / Tag)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?type=BOOKMARK&q=vite&tag=tooling",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                { "key": "type", "value": "BOOKMARK" },
                { "key": "q", "value": "vite" },
                { "key": "tag", "value": "tooling" },
                { "key": "favorites", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Bookmark Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BOOKMARK\",\n  \"title\": \"MDN Web Docs\",\n  \"url\": \"https://developer.mozilla.org\",\n  \"description\": \"Resources for developers by developers\",\n  \"tags\": [\"web\", \"docs\", \"javascript\"],\n  \"isFavorite\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Create Code Snippet Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SNIPPET\",\n  \"title\": \"Quick Sleep helper\",\n  \"language\": \"javascript\",\n  \"content\": \"const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));\",\n  \"description\": \"Utility promise sleep delay\",\n  \"tags\": [\"javascript\", \"async\", \"utility\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Create Markdown Note Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"NOTE\",\n  \"title\": \"Meeting Action Items\",\n  \"content\": \"# Sprint Planning\\n\\n- [x] Configure Postman collections\\n- [ ] Deploy to staging server\\n- [ ] Update documentation\\n\",\n  \"tags\": [\"work\", \"notes\", \"sprint\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Update Item by ID",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Item Title\",\n  \"isFavorite\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "REPLACE_WITH_ITEM_ID"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Item by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "REPLACE_WITH_ITEM_ID"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Get Tags with Item Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["tags"]
            }
          }
        }
      ]
    },
    {
      "name": "Metadata Scraper",
      "item": [
        {
          "name": "Scrape URL Metadata (OpenGraph)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://github.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metadata",
              "host": ["{{baseUrl}}"],
              "path": ["metadata"]
            }
          }
        }
      ]
    },
    {
      "name": "Seed",
      "item": [
        {
          "name": "Seed Sample Data",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seed",
              "host": ["{{baseUrl}}"],
              "path": ["seed"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
