{
  "name": "quickvault",
  "version": "1.0.0",
  "description": "QuickVault — Smart Bookmark & Notes Hub",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "client": "vite client --port 3000",
    "client:dev": "vite client --port 3000",
    "build": "vite build client",
    "preview": "vite preview client",
    "start": "node server/server.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "vite": "^6.2.0"
  }
}
